# Local development environment
ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Taipei

# Local SQLite database for rapid pilot/development (can switch to PostgreSQL for on-premise production)
DATABASE_URL=sqlite:///./dev_attendance.db

# Phase 1 影子模式：與現有 HR/紙本平行運作，加班為候選值，絕不自動送薪資 (R4)
SHADOW_MODE=true

# WebAuthn (CLAUDE.md §8)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=醫院員工出勤系統
WEBAUTHN_ORIGIN=http://localhost:5173

JWT_SECRET=pilot-development-secret-key-yangming
JWT_EXPIRE_MINUTES=480

# --- 勞基法政策參數 (CLAUDE.md §7) ---
LABOR_DAILY_REGULAR_MINUTES=480
LABOR_WEEKLY_REGULAR_MINUTES=2400
LABOR_DAILY_MAX_MINUTES=720
LABOR_MONTHLY_OVERTIME_CAP_MINUTES=2760
LABOR_MIN_SHIFT_INTERVAL_MINUTES=660
LABOR_LABOR_RULES_REVIEWED=false

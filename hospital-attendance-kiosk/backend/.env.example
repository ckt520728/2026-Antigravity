# 複製為 .env 後修改。.env 不得進版控。

ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Taipei

# CLAUDE.md R7：開發／測試環境僅可使用合成或不可逆去識別化資料。
DATABASE_URL=postgresql+psycopg://attendance:attendance@localhost:5432/attendance

# Phase 1 影子模式：與現有 HR/紙本平行運作，加班為候選值，絕不自動送薪資 (R4)。
SHADOW_MODE=true

# WebAuthn (CLAUDE.md §8)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=醫院員工出勤系統
WEBAUTHN_ORIGIN=http://localhost:5173

# 正式環境必須改掉
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# --- 勞基法政策參數 (CLAUDE.md §7) ---
# 未經人事室與勞動法規權責單位複核前，LABOR_LABOR_RULES_REVIEWED 必須維持 false。
LABOR_DAILY_REGULAR_MINUTES=480
LABOR_WEEKLY_REGULAR_MINUTES=2400
LABOR_DAILY_MAX_MINUTES=720
LABOR_MONTHLY_OVERTIME_CAP_MINUTES=2760
LABOR_MIN_SHIFT_INTERVAL_MINUTES=660
LABOR_LABOR_RULES_REVIEWED=false
